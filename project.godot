config_version=5

[application]
config/name="Quarry Days"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
place_machine={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
rotate_machine={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
save_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194336)]}
load_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194340)]}
